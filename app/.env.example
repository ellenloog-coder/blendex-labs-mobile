# Optional override for the Blendex Labs AI Worker endpoint.
# Defaults to the deployed worker:
# https://quality-tools-ai-assistant.quality-tools-ai-assistant.workers.dev
#
# Note: the worker must allow this site's origin in its CORS allow-list,
# otherwise browser requests are rejected with origin_not_allowed.
VITE_AI_WORKER_URL=https://quality-tools-ai-assistant.quality-tools-ai-assistant.workers.dev
